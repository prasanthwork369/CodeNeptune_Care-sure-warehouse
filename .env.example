# Copy this file to .env.local (gitignored) for local development,
# or generate it with: eas env:pull --environment development
# Cloud builds and updates read these from EAS environments, not from this file.

# "development" | "preview" | "production" (any other value fails the build)
EXPO_PUBLIC_APP_ENV=development

# Backend API origin (required)
EXPO_PUBLIC_API_BASE_URL=https://uat-api.caresureindia.com

# Production values belong only in the EAS "production" environment.
# The production API URL must use https://.
